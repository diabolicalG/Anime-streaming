# Database
DB_USER=anime_user
DB_PASSWORD=anime_pass
DATABASE_URL=postgresql://anime_user:anime_pass@localhost:5432/anime_streaming?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT (generate: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cookies
COOKIE_DOMAIN=localhost

# Frontend
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000

# External APIs
ANILIST_API_URL=https://graphql.anilist.co
CONSUMET_BASE_URL=https://api.consumet.org
ANIVEXA_BASE_URL=https://api.anivexa.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Provider Mapping
PROVIDER_MAPPING_CONFIDENCE_THRESHOLD=0.85

# Demo Seed (DEVELOPMENT ONLY)
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=changeme123
DEMO_USER_USERNAME=demo

# Node
NODE_ENV=development
PORT=3000
